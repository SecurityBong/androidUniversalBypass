    });

    // ── F. Integrity verdict parsing — hook common check patterns ─
    // Apps decode the JWT payload and check specific string fields.
    // Hook String.equals and contains to intercept verdict comparisons.
    safeHook(function() {
        var String_cls = Java.use("java.lang.String");
        var INTEGRITY_VERDICTS = [
            "MEETS_DEVICE_INTEGRITY",
            "MEETS_BASIC_INTEGRITY",
            "MEETS_STRONG_INTEGRITY",
            "MEETS_VIRTUAL_INTEGRITY",
            "PLAY_RECOGNIZED",
            "LICENSED",
            "UNEVALUATED"  // treat as passing
        ];
        var BAD_VERDICTS = [
            "UNRECOGNIZED_VERSION",
            "UNLICENSED",
            "MEETS_NO_INTEGRITY",
            "UNEVALUATED"  // some apps reject this
        ];
        // Hook contains() — most JSON/JWT verdict checks use this
        String_cls.contains.overload("java.lang.CharSequence").implementation = function(seq) {
            if (seq !== null) {
                var s = seq.toString();
                // If app asks "does response contain BAD_VERDICT" → return false
                if (BAD_VERDICTS.indexOf(s) !== -1) {
                    console.log("[bypass] String.contains("+s+") -> false (bad verdict blocked)");
                    return false;
                }
                // If app asks "does response contain GOOD_VERDICT" → return true
                if (INTEGRITY_VERDICTS.indexOf(s) !== -1) {
                    console.log("[bypass] String.contains("+s+") -> true (good verdict forced)");
                    return true;
                }
            }
            return this.contains(seq);
        };
        console.log("[+] PlayIntegrity: String.contains verdict hook active");
    });

    // ── G. GoogleApiAvailability — report Play Services available ─
    safeUse("com.google.android.gms.common.GoogleApiAvailability", function(G) {
        try { G.isGooglePlayServicesAvailable.overload("android.content.Context")
            .implementation = function() { return 0; }; } catch(e) {} // CONNECTION_SUCCESS
        try { G.isGooglePlayServicesAvailable.overload("android.content.Context","int")
            .implementation = function() { return 0; }; } catch(e) {}
        try { G.makeGooglePlayServicesAvailable.implementation = function() {
            return _buildSuccessTask(null);
        }; } catch(e) {}
        console.log("[+] GoogleApiAvailability patched");
    });

    // ── H. Task helpers — build fake passing Tasks ────────────────
    // Many Play Integrity / SafetyNet calls return a Task<T>.
    // We need to return a Task that immediately calls onSuccess.
    function _buildSuccessTask(result) {
        // Try com.google.android.gms.tasks.Tasks.forResult()
        try {
            var Tasks = Java.use("com.google.android.gms.tasks.Tasks");
            return Tasks.forResult(result);
        } catch(e) {}
        return null;
    }

    // ── I. Fake integrity token (base64 JWT with passing verdicts) ─
    // This is a structurally valid JWT with a payload that decodes to
    // all-passing verdicts. The signature is fake but most apps don't
    // verify the signature client-side (they send it to their server).
    // For CTF, the server may also not verify it strictly.
    function _buildFakeIntegrityToken() {
        // Header: {"alg":"RS256","typ":"JWT"}
        // Payload contains all passing verdicts:
        // {
        //   "requestDetails": {"requestPackageName":"com.target.app","timestampMillis":"...","nonce":"..."},
        //   "appIntegrity": {"appRecognitionVerdict":"PLAY_RECOGNIZED","packageName":"com.target.app","certificateSha256Digest":[],"versionCode":"1"},
        //   "deviceIntegrity": {"deviceRecognitionVerdict":["MEETS_DEVICE_INTEGRITY","MEETS_BASIC_INTEGRITY","MEETS_STRONG_INTEGRITY"]},
        //   "accountDetails": {"appLicensingVerdict":"LICENSED"}
        // }
        var header  = "eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9";
        var payload = "";
        var sig     = "fakesignature_ctf_bypass";
        return header+"."+payload+"."+sig;
    }

    // Fake SafetyNet JWS (older format)
    function _buildFakeSafetyNetJwt() {
        var header  = "eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9";
        // {"nonce":"fake","timestampMs":1749550000000,"apkPackageName":"com.target.app",
        //  "apkCertificateDigestSha256":[],"ctsProfileMatch":true,"basicIntegrity":true,
        //  "evaluationType":"BASIC,HARDWARE_BACKED"}
        var payload = "eyJub25jZSI6ImZha2UiLCJ0aW1lc3RhbXBNcyI6MTc0OTU1MDAwMDAwMCwiYXBrUGFja2FnZU5hbWUiOiJjb20udGFyZ2V0LmFwcCIsImFwa0NlcnRpZmljYXRlRGlnZXN0U2hhMjU2IjpbXSwiY3RzUHJvZmlsZU1hdGNoIjp0cnVlLCJiYXNpY0ludGVncml0eSI6dHJ1ZSwiZXZhbHVhdGlvblR5cGUiOiJCQVNJQyxIQVJEV0FSRV9CQUNLRUQIFQ";
        var sig     = "fakesig_safetynet_ctf";
        return header+"."+payload+"."+sig;
    }

    // ── J. Sniff any JSON/string containing integrity verdict words ─
    // Some apps parse the token themselves using JSONObject.
    safeUse("org.json.JSONObject", function(JO) {
        try {
            JO.getString.overload("java.lang.String").implementation = function(key) {
                var val = this.getString(key);
                // If the app reads a verdict field and gets a bad value, replace it
                if (key === "appRecognitionVerdict" || key === "appLicensingVerdict") {
                    if (val !== "PLAY_RECOGNIZED" && val !== "LICENSED") {
                        console.log("[bypass] JSONObject.getString("+key+") was "+val+" -> replaced");
                        return key === "appLicensingVerdict" ? "LICENSED" : "PLAY_RECOGNIZED";
                    }
                }
                return val;
            };
        } catch(e) {}
        try {
            JO.getJSONArray.overload("java.lang.String").implementation = function(key) {
                var arr = this.getJSONArray(key);
                if (key === "deviceRecognitionVerdict") {
                    console.log("[bypass] deviceRecognitionVerdict array intercepted");
                    // Return an array with all passing verdicts
                    var JA = Java.use("org.json.JSONArray");
                    var result = JA.$new();
                    result.put("MEETS_DEVICE_INTEGRITY");
                    result.put("MEETS_BASIC_INTEGRITY");
                    result.put("MEETS_STRONG_INTEGRITY");
                    return result;
                }
                return arr;
            };
        } catch(e) {}
        console.log("[+] PlayIntegrity: JSONObject verdict parsing patched");
    });

    // ================================================================
    // BIOMETRIC — all variants
    // ================================================================

    // ── androidx.biometric.BiometricPrompt ────────────────────────
    safeUse("androidx.biometric.BiometricPrompt", function(BP) {
        var cbMap={};

        function storeCb(instance, cb) {
            var key=instance.hashCode()+"";
            cbMap[key]=Java.retain(cb); // retain RETURN VALUE, not original wrapper
            console.log("[bypass] bio callback retained key="+key);
        }
        function getCb(instance) { return cbMap[instance.hashCode()+""]||null; }

        // Build a real AuthenticationResult — @NonNull enforced by Kotlin
        function buildResult() {
            // Try androidx AuthenticationResult constructors in order of likelihood
            var AR=null;
            try { AR=Java.use("androidx.biometric.BiometricPrompt$AuthenticationResult"); } catch(e) { return null; }
            // (CryptoObject, int) — most common
            try { return AR.$new(null,2); } catch(e) {}
            // (CryptoObject, int, int) — newer versions
            try { return AR.$new(null,2,0); } catch(e) {}
            // No-arg — some older versions
            try { return AR.$new(); } catch(e) {}
            return null;
        }

        function fireSuccess(instance) {
            var cb=getCb(instance);
            if (!cb) {
                // Reflection fallback — scan fields for callback
                try {
                    var cls=instance.getClass();
                    outer: while(cls!==null) {
                        var fields=cls.getDeclaredFields();
                        for(var i=0;i<fields.length;i++) {
                            try {
                                fields[i].setAccessible(true);
                                var val=fields[i].get(instance);
                                if(val!==null&&val.getClass().getName().indexOf("AuthenticationCallback")!==-1) {
                                    cb=Java.retain(val);
                                    console.log("[bypass] bio cb via reflection: "+val.getClass().getName());
                                    break outer;
                                }
                            } catch(fe) {}
                        }
                        try { cls=cls.getSuperclass(); } catch(e) { break; }
                    }
                } catch(e) {}
            }
            if (!cb) { console.log("[!] bio: no callback found"); return; }
            var retained=cb;
            Java.scheduleOnMainThread(function() {
                // Attempt 1: real AuthenticationResult (satisfies @NonNull)
                var result=buildResult();
                if (result!==null) {
                    try { retained.onAuthenticationSucceeded(result);
                          console.log("[bypass] bio success (AuthResult)"); return; } catch(e) { console.log("[!] bio AuthResult: "+e); }
                }
                // Attempt 2: null (works if app doesn't enforce @NonNull strictly)
                try { retained.onAuthenticationSucceeded(null);
                      console.log("[bypass] bio success (null)"); return; } catch(e) { console.log("[!] bio null: "+e); }
                // Attempt 3: onAuthenticationError with code that app treats as "ok"
                try { retained.onAuthenticationError(5,"Bypass");
                      console.log("[bypass] bio via onAuthenticationError"); } catch(e) { console.log("[!] bio error cb: "+e); }
            });
        }

        // Hook ALL constructor overloads — callback is ALWAYS the last arg
        [
            ["androidx.fragment.app.FragmentActivity","java.util.concurrent.Executor","androidx.biometric.BiometricPrompt$AuthenticationCallback"],
            ["androidx.fragment.app.FragmentActivity","androidx.biometric.BiometricPrompt$AuthenticationCallback"],
            ["androidx.fragment.app.Fragment","java.util.concurrent.Executor","androidx.biometric.BiometricPrompt$AuthenticationCallback"],
            ["androidx.fragment.app.Fragment","androidx.biometric.BiometricPrompt$AuthenticationCallback"]
        ].forEach(function(sig) {
            try {
                BP.$init.overload.apply(BP.$init, sig).implementation=function() {
                    var args=Array.prototype.slice.call(arguments);
                    var cb=args[args.length-1];
                    storeCb(this,cb);
                    return this.$init.apply(this,args);
                };
                console.log("[+] bio ctor("+sig.length+" args) hooked");
            } catch(e) {}
        });

        // authenticate overloads
        try { BP.authenticate.overload("androidx.biometric.BiometricPrompt$PromptInfo")
            .implementation=function(info){ console.log("[bypass] BP.authenticate"); fireSuccess(this); }; } catch(e) {}
        try { BP.authenticate.overload("androidx.biometric.BiometricPrompt$PromptInfo","androidx.biometric.BiometricPrompt$CryptoObject")
            .implementation=function(info,co){ console.log("[bypass] BP.authenticate(crypto)"); fireSuccess(this); }; } catch(e) {}

        // cancelAuthentication — prevent app from cancelling our injected auth
        try { BP.cancelAuthentication.implementation=function(){ console.log("[bypass] cancelAuthentication suppressed"); }; } catch(e) {}

        console.log("[+] androidx BiometricPrompt fully patched");
    });

    // ── android.hardware.biometrics.BiometricPrompt (API 28+) ─────
    safeUse("android.hardware.biometrics.BiometricPrompt", function(BP) {
        function hwBuildResult() {
            try {
                var AR=Java.use("android.hardware.biometrics.BiometricPrompt$AuthenticationResult");
                try { return AR.$new(null); } catch(e) {}
                try { return AR.$new(null,2); } catch(e) {}
                try { return AR.$new(null,2,0); } catch(e) {}
            } catch(e) {}
            return null;
        }
        function hwFire(cb) {
            if(!cb) return;
            var retained=Java.retain(cb);
            Java.scheduleOnMainThread(function() {
                var result=hwBuildResult();
                if(result!==null) { try { retained.onAuthenticationSucceeded(result); console.log("[bypass] hw bio (AuthResult)"); return; } catch(e) {} }
                try { retained.onAuthenticationSucceeded(null); console.log("[bypass] hw bio (null)"); } catch(e) {}
            });
        }
        try { BP.authenticate.overload("android.os.CancellationSignal","java.util.concurrent.Executor","android.hardware.biometrics.BiometricPrompt$AuthenticationCallback")
            .implementation=function(cs,ex,cb){ console.log("[bypass] hw BP.authenticate"); hwFire(cb); }; } catch(e) {}
        try { BP.authenticate.overload("android.hardware.biometrics.BiometricPrompt$CryptoObject","android.os.CancellationSignal","java.util.concurrent.Executor","android.hardware.biometrics.BiometricPrompt$AuthenticationCallback")
            .implementation=function(co,cs,ex,cb){ console.log("[bypass] hw BP.authenticate(crypto)"); hwFire(cb); }; } catch(e) {}
        console.log("[+] hw BiometricPrompt patched");
    });

