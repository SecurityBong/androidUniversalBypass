"use strict";
// ================================================================
// CTF Universal Bypass — v11 (definitive)
// Covers ALL 5 apps: Root, SSL, Biometric, Anti-Hook, RASP,
//                    Continuous detection polling, Dialog suppress
//
// USAGE:
//   frida -U -f com.your.target.app -l ctf_bypass_universal.js --no-pause
//   frida -U -n "AppName" -l ctf_bypass_universal.js \
//         --script-args="com.your.target.app" --no-pause
// ================================================================

// ================================================================
// HELPERS — available before any Java.perform
// ================================================================
function safeUse(cls, cb) { try { cb(Java.use(cls)); } catch(e) {} }
function safeHook(fn)      { try { fn(); } catch(e) {}  }

var ROOT_TOKENS = ["/su","magisk","supersu","superuser","busybox","frida",
                   "gum-js","linjector","xposed","substrate","rootcloak",
                   "rootbeer","chainfire","kinguser","kingo","vboxguest","vboxuser"];
var SAFE_TOKENS = ["com.google","/gms/","firebase","googleapis"];
function isRootPath(p) {
    if (!p) return false;
    var l = p.toLowerCase();
    for (var i=0;i<SAFE_TOKENS.length;i++) if (l.indexOf(SAFE_TOKENS[i])!==-1) return false;
    for (var i=0;i<ROOT_TOKENS.length;i++) if (l.indexOf(ROOT_TOKENS[i])!==-1) return true;
    return false;
}
var SU_PATHS = [
    "/data/local/su","/data/local/bin/su","/data/local/xbin/su",
    "/sbin/su","/su/bin/su","/system/bin/su","/system/bin/.ext/su",
    "/system/bin/failsafe/su","/system/sd/xbin/su",
    "/system/usr/we-need-root/su","/system/xbin/su",
    "/cache/su","/data/su","/dev/su","/product/bin/su",
    "/apex/com.android.runtime/bin/su","/apex/com.android.art/bin/su",
    "/system_ext/bin/su","/odm/bin/su","/vendor/bin/su","/vendor/xbin/su",
    "/system/app/Superuser.apk","/system/app/SuperSU.apk",
    "/system/app/KingoUser.apk","/system/app/Magisk.apk"
];
var ROOT_PKGS = [
    "com.noshufou.android.su","com.noshufou.android.su.elite",
    "eu.chainfire.supersu","eu.chainfire.supersu.pro",
    "com.koushikdutta.superuser","com.thirdparty.superuser",
    "com.yellowes.su","com.kingouser.com","com.topjohnwu.magisk",
    "com.devadvance.rootcloak","com.devadvance.rootcloakplus",
    "de.robv.android.xposed.installer","com.saurik.substrate",
    "me.phh.superuser","io.github.vvb2060.magisk","me.weishu.kernelsu",
    "com.koushikdutta.rommanager","com.zachspong.temprootremovejb",
    "com.ramdroid.appquarantine"
];
var PROC_BLOCK = ["/proc/net/tcp","/proc/net/tcp6","/proc/self/maps",
                  "/proc/self/status","/proc/self/fd","/proc/self/task"];
var PROC_SAFE  = "/proc/net/arp";
var EXEC_BLOCK = ["frida","getprop","build.prop","magisk","busybox",
                  "which su","pm list","mount","df ","id "];
function isBlockedCmd(cmd) {
    if (!cmd) return false;
    var c = cmd.toLowerCase().trim();
    if (c==="su"||c==="id") return true;
    if (c.indexOf("ps ")!==-1 && c.indexOf("grep")!==-1) return true;
    for (var i=0;i<EXEC_BLOCK.length;i++) if (c.indexOf(EXEC_BLOCK[i])!==-1) return true;
    return false;
}
var DIALOG_WORDS = ["root","detect","tamper","jailbreak","hook",
                    "integrity","unsafe","threat","compromise","modif",
                    "security","block","forbid","prohibit","restrict"];
function isSecurityMsg(msg) {
    if (!msg) return false;
    var m = msg.toString().toLowerCase();
    for (var i=0;i<DIALOG_WORDS.length;i++) if (m.indexOf(DIALOG_WORDS[i])!==-1) return true;
    return false;
}

// ================================================================
// STAGE 1 — Native hooks (synchronous, always first)
// ================================================================
console.log("[v11] Stage 1: Native");

// ── Kill signals ────────────────────────────────────────────────
safeHook(function() {
    Interceptor.attach(Module.getGlobalExportByName("kill"), {
        onEnter: function(args) {
            var sig=args[1].toInt32(), pid=args[0].toInt32();
            if ((sig===9||sig===15||sig===6||sig===11)&&(pid===Process.id||pid===0)) {
                console.log("[bypass] kill("+pid+","+sig+") blocked");
                args[1]=ptr(0);
            }
        }
    });
});
safeHook(function() {
    Interceptor.attach(Module.getGlobalExportByName("raise"), {
        onEnter: function(args) {
            var sig=args[0].toInt32();
            if (sig===9||sig===15||sig===6||sig===11) {
                console.log("[bypass] raise("+sig+") blocked");
                args[0]=ptr(0);
            }
        }
    });
});
safeHook(function() {
    Interceptor.replace(Module.getGlobalExportByName("abort"),
        new NativeCallback(function(){ console.log("[bypass] abort blocked"); },"void",[]));
});
safeHook(function() {
    var exp=Module.findExportByName("libc.so","pthread_kill"); if(!exp) return;
    Interceptor.attach(exp, {
        onEnter: function(args) {
            var sig=args[1].toInt32();
            if (sig===9||sig===15||sig===6) { console.log("[bypass] pthread_kill blocked"); args[1]=ptr(0); }
        }
    });
});

// ── libc file checks ────────────────────────────────────────────
safeHook(function() {
    Interceptor.attach(Module.getExportByName("libc.so","access"), {
        onEnter: function(args) { this.path=args[0].readUtf8String(); },
        onLeave: function(retval) {
            if (isRootPath(this.path)) { console.log("[bypass] access: "+this.path); retval.replace(ptr(-1)); }
        }
    });
});
["stat","stat64","lstat","lstat64"].forEach(function(fn) {
    safeHook(function() {
        var exp=Module.findExportByName("libc.so",fn); if(!exp) return;
        Interceptor.attach(exp, {
            onEnter: function(args) { this.path=args[0].readUtf8String(); },
            onLeave: function(retval) {
                if (isRootPath(this.path)) { console.log("[bypass] "+fn+": "+this.path); retval.replace(ptr(-1)); }
            }
        });
    });
});
safeHook(function() {
    Interceptor.attach(Module.getExportByName("libc.so","open"), {
        onEnter: function(args) {
            try { this.path=args[0].readUtf8String(); } catch(e) {}
            if (isRootPath(this.path)) { console.log("[bypass] open: "+this.path); args[0]=Memory.allocUtf8String("/dev/null"); }
        }
    });
});
safeHook(function() {
    var exp=Module.findExportByName("libc.so","fopen"); if(!exp) return;
    Interceptor.attach(exp, {
        onEnter: function(args) {
            try { this.path=args[0].readUtf8String(); } catch(e) {}
            if (isRootPath(this.path)) { console.log("[bypass] fopen: "+this.path); args[0]=Memory.allocUtf8String("/dev/null"); }
        }
    });
});
safeHook(function() {
    var exp=Module.findExportByName("libc.so","strstr"); if(!exp) return;
    var orig=new NativeFunction(exp,"pointer",["pointer","pointer"]);
    Interceptor.replace(exp, new NativeCallback(function(hay,needle) {
        try {
            var n=needle.readUtf8String();
            if (n&&(n.indexOf("frida")!==-1||n.indexOf("gum-js")!==-1||
                    n.indexOf("magisk")!==-1||n.indexOf("xposed")!==-1)) return ptr(0);
        } catch(e) {}
        return orig(hay,needle);
    },"pointer",["pointer","pointer"]));
});

// ── Native SSL ───────────────────────────────────────────────────
safeHook(function() {
    var exp=Module.findExportByName("libssl.so","SSL_CTX_set_verify"); if(!exp) return;
    Interceptor.attach(exp, { onEnter: function(args) { args[1]=ptr(0); } });
});
safeHook(function() {
    var exp=Module.findExportByName("libssl.so","SSL_get_verify_result"); if(!exp) return;
    Interceptor.replace(exp, new NativeCallback(function(s){return 0;},"long",["pointer"]));
});
console.log("[v11] Stage 1 done");

// ================================================================
// STAGE 2 — Java.performNow (SYNCHRONOUS — before app code runs)
// Critical: kill, finish, dialogs, SSL core hooks
// ================================================================
console.log("[v11] Stage 2: Synchronous Java hooks");

Java.performNow(function() {

    // ── Process kill ──────────────────────────────────────────────
    safeHook(function() {
        Java.use("java.lang.System").exit.implementation =
            function(c) { console.log("[bypass] System.exit("+c+") blocked"); };
    });
    safeHook(function() {
        Java.use("android.os.Process").killProcess.implementation =
            function(p) { console.log("[bypass] killProcess("+p+") blocked"); };
    });
    safeHook(function() {
        Java.use("java.lang.Runtime").halt.implementation =
            function(c) { console.log("[bypass] halt("+c+") blocked"); };
    });

    // ── Activity termination — UNCONDITIONAL permanent block ──────
    safeHook(function() {
        var A=Java.use("android.app.Activity");
        A.finish.implementation            = function() { console.log("[bypass] finish() in "+this.getClass().getName()); };
        A.finishAffinity.implementation    = function() { console.log("[bypass] finishAffinity() blocked"); };
        A.finishAndRemoveTask.implementation = function() { console.log("[bypass] finishAndRemoveTask() blocked"); };
        A.moveTaskToBack.implementation    = function(b) { console.log("[bypass] moveTaskToBack() blocked"); return false; };
        console.log("[sync] Activity termination blocked");
    });

    // ── Static "rooted device" page patterns ─────────────────────
    // Pattern: app shows a dedicated Activity/Fragment as a block screen.
    // Three sub-patterns:
    //   A. setContentView(R.layout.security_block) — hook setContentView
    //   B. onResume() calls detection and shows block UI inline
    //   C. App navigates to a block Activity via startActivity(Intent)
    // We handle all three here.

    safeHook(function() {
        var Activity = Java.use("android.app.Activity");
        var origSetContentView_int = Activity.setContentView.overload("int");
        var origSetContentView_view = Activity.setContentView.overload("android.view.View");

        // Hook setContentView to detect block screens being inflated.
        // We log the resource ID — if the same ID always appears when blocked,
        // add it to BLOCK_LAYOUT_IDS below.
        var BLOCK_LAYOUT_IDS = []; // populated at runtime from logs

        origSetContentView_int.implementation = function(layoutResId) {
            var actName = this.getClass().getName().toLowerCase();
            // Log every setContentView call from the app so we can identify block layouts
            if (PKG !== "" && this.getClass().getName().indexOf(PKG) === 0) {
                console.log("[layout] setContentView("+layoutResId+") in "+this.getClass().getName());
            }
            if (BLOCK_LAYOUT_IDS.indexOf(layoutResId) !== -1) {
                console.log("[bypass] setContentView blocked (known block layout): "+layoutResId);
                return; // don't inflate the block screen
            }
            return origSetContentView_int.call(this, layoutResId);
        };
        console.log("[sync] Activity.setContentView monitored");
    });

    // Hook startActivity — some apps start a dedicated BlockActivity
    safeHook(function() {
        var Activity = Java.use("android.app.Activity");
        var origStart = Activity.startActivity.overload("android.content.Intent");
        origStart.implementation = function(intent) {
            try {
                var comp = intent.getComponent();
                if (comp !== null) {
                    var cls = comp.getClassName().toLowerCase();
                    if (cls.indexOf("block") !== -1 || cls.indexOf("restrict") !== -1 ||
                        cls.indexOf("security") !== -1 || cls.indexOf("root") !== -1 ||
                        cls.indexOf("tamper") !== -1 || cls.indexOf("integrity") !== -1) {
                        console.log("[bypass] startActivity BLOCKED: "+comp.getClassName());
                        return;
                    }
                }
                // Log all startActivity from app package for diagnosis
                if (PKG !== "" && intent.getComponent() !== null) {
                    var cn = intent.getComponent().getClassName();
                    if (cn.indexOf(PKG) === 0) console.log("[intent] startActivity: "+cn);
                }
            } catch(e) {}
            return origStart.call(this, intent);
        };
        console.log("[sync] Activity.startActivity monitored");
    });

    // Hook Fragment.onResume — block screens implemented as fragments
    // call their detection in onResume and show inline UI
    safeHook(function() {
        var Fragment = Java.use("androidx.fragment.app.Fragment");
        var origOnResume = Fragment.onResume;
        Fragment.onResume.implementation = function() {
            var cls = this.getClass().getName();
            if (PKG !== "" && cls.indexOf(PKG) === 0) {
                var c = cls.toLowerCase();
                if (c.indexOf("block") !== -1 || c.indexOf("security") !== -1 ||
                    c.indexOf("root") !== -1   || c.indexOf("restrict") !== -1 ||
                    c.indexOf("tamper") !== -1  || c.indexOf("integrity") !== -1) {
                    console.log("[bypass] Fragment.onResume BLOCKED: "+cls);
                    return; // don't resume the block fragment
                }
                console.log("[fragment] onResume: "+cls);
            }
            return origOnResume.call(this);
        };
        console.log("[sync] Fragment.onResume monitored");
    });

    // Hook View visibility — static block screens often use setVisibility(VISIBLE)
    // to show an overlay. Block security-named views from becoming visible.
    safeHook(function() {
        var View = Java.use("android.view.View");
        var origSetVis = View.setVisibility;
        View.setVisibility.implementation = function(visibility) {
            if (visibility === 0) { // VISIBLE
                try {
                    var tag = this.getTag();
                    if (tag !== null && isSecurityMsg(tag.toString())) {
                        console.log("[bypass] View.setVisibility(VISIBLE) blocked for tag: "+tag);
                        return origSetVis.call(this, 8); // GONE instead
                    }
                } catch(e) {}
            }
            return origSetVis.call(this, visibility);
        };
        console.log("[sync] View.setVisibility monitored");
    });

    // ── Dialog.show — suppress security dialogs ───────────────────
    safeHook(function() {
        var Dialog=Java.use("android.app.Dialog");
        Dialog.show.implementation = function() {
            try {
                var ad=Java.cast(this, Java.use("android.app.AlertDialog"));
                var tv=ad.findViewById(Java.use("android.R$id").message.value);
                if (tv!==null) {
                    var msg=Java.cast(tv,Java.use("android.widget.TextView")).getText().toString();
                    if (isSecurityMsg(msg)) { console.log("[bypass] Dialog suppressed: "+msg); return; }
                }
            } catch(e) {}
            return this.show();
        };
        Dialog.setTitle.overload("java.lang.CharSequence").implementation = function(t) {
            if (isSecurityMsg(t)) { console.log("[bypass] Dialog.setTitle suppressed: "+t); return this.setTitle("Notice"); }
            return this.setTitle(t);
        };
        console.log("[sync] Dialog.show hooked");
    });

    // ── AlertDialog.Builder — all variants ───────────────────────
    // KEY FIX: must call the specific overload via .call(this, ...) to avoid
    // infinite recursion. this.setTitle(resId) inside a hooked setTitle(int)
    // calls our own hook again → NPE / stack overflow.
    // Always use B.setMessage.overload(...).call(this, ...) instead.
    function resolveResId(builder, resId) {
        try { return builder.getContext().getString(resId); } catch(e) { return ""; }
    }
    function patchBuilder(B, tag) {
        // Cache the original overload references BEFORE replacing implementations
        // so we can call them directly without triggering our own hooks.
        var origMsgStr  = null; try { origMsgStr  = B.setMessage.overload("java.lang.CharSequence"); } catch(e) {}
        var origMsgInt  = null; try { origMsgInt  = B.setMessage.overload("int"); } catch(e) {}
        var origTitStr  = null; try { origTitStr  = B.setTitle.overload("java.lang.CharSequence"); } catch(e) {}
        var origTitInt  = null; try { origTitInt  = B.setTitle.overload("int"); } catch(e) {}

        // setMessage(CharSequence)
        if (origMsgStr) try { origMsgStr.implementation = function(msg) {
            if (isSecurityMsg(msg)) {
                console.log("[bypass] "+tag+" msg(str): "+msg);
                return origMsgStr.call(this, "All good!");
            }
            return origMsgStr.call(this, msg);
        }; } catch(e) {}

        // setMessage(int resId)
        if (origMsgInt) try { origMsgInt.implementation = function(resId) {
            var resolved = resolveResId(this, resId);
            console.log("[bypass] "+tag+" msg(resId="+resId+"): "+resolved);
            if (isSecurityMsg(resolved)) {
                // Replace with safe string overload — no recursion since
                // origMsgStr still points to the original implementation
                return origMsgStr !== null
                    ? origMsgStr.call(this, "All good!")
                    : origMsgInt.call(this, resId);
            }
            return origMsgInt.call(this, resId);
        }; } catch(e) {}

        // setTitle(CharSequence)
        if (origTitStr) try { origTitStr.implementation = function(t) {
            if (isSecurityMsg(t)) {
                console.log("[bypass] "+tag+" title(str): "+t);
                return origTitStr.call(this, "Notice");
            }
            return origTitStr.call(this, t);
        }; } catch(e) {}

        // setTitle(int resId) — THE FIX for the crash in your log
        // Previous version called this.setTitle(resId) which recursed into our hook
        if (origTitInt) try { origTitInt.implementation = function(resId) {
            var resolved = resolveResId(this, resId);
            console.log("[bypass] "+tag+" title(resId="+resId+"): "+resolved);
            if (isSecurityMsg(resolved)) {
                return origTitStr !== null
                    ? origTitStr.call(this, "Notice")
                    : origTitInt.call(this, resId);
            }
            return origTitInt.call(this, resId);
        }; } catch(e) {}

        // Strip ALL button listeners — cache originals first
        ["setPositiveButton","setNegativeButton","setNeutralButton"].forEach(function(btn) {
            var origBtnStr = null; try { origBtnStr = B[btn].overload("java.lang.CharSequence","android.content.DialogInterface$OnClickListener"); } catch(e) {}
            var origBtnInt = null; try { origBtnInt = B[btn].overload("int","android.content.DialogInterface$OnClickListener"); } catch(e) {}
            if (origBtnStr) try { origBtnStr.implementation = function(t,l) {
                console.log("[bypass] "+tag+" "+btn+"(str) stripped");
                return origBtnStr.call(this, t, null);
            }; } catch(e) {}
            if (origBtnInt) try { origBtnInt.implementation = function(id,l) {
                console.log("[bypass] "+tag+" "+btn+"(id) stripped");
                return origBtnInt.call(this, id, null);
            }; } catch(e) {}
        });
        console.log("[sync] "+tag+" patched");
    }
    safeHook(function() { patchBuilder(Java.use("android.app.AlertDialog$Builder"),"AlertDialog"); });

    // ── SSL — synchronous core hooks (catch pre-built OkHttp clients) ─
    // OkHttp builds SSLSocketFactory at startup. Java.perform() may be
    // too late. These run NOW so every connection is covered.
    safeUse("com.android.org.conscrypt.TrustManagerImpl", function(TM) {
        try { TM.verifyChain.implementation =
            function(u,a,h,c,o,s){ console.log("[bypass] verifyChain: "+h); return u; }; } catch(e) {}
        try { TM.checkTrustedRecursive.implementation =
            function(ce,h,c,u,t,us){
                var r=Java.use("java.util.ArrayList").$new();
                try{if(u!==null)r.addAll(u);}catch(e){} return r;
            }; } catch(e) {}
        try { TM.checkServerTrusted.overload(
            "[Ljava.security.cert.X509Certificate;","java.lang.String","java.lang.String"
        ).implementation=function(ch,a,h){ return Java.use("java.util.Arrays").asList(ch); }; } catch(e) {}
        try { TM.checkServerTrusted.overload(
            "[Ljava.security.cert.X509Certificate;","java.lang.String"
        ).implementation=function(ch,a){}; } catch(e) {}
        console.log("[sync] conscrypt TrustManagerImpl patched");
    });
    safeUse("android.net.http.X509TrustManagerExtensions", function(TME) {
        try { TME.checkServerTrusted.overload(
            "[Ljava.security.cert.X509Certificate;","java.lang.String","java.lang.String"
        ).implementation=function(ch,a,h){ return Java.use("java.util.Arrays").asList(ch); }; } catch(e) {}
        console.log("[sync] X509TrustManagerExtensions patched");
    });
    safeUse("okhttp3.internal.platform.android.AndroidCertificateChainCleaner", function(C) {
        try { C.clean.overload("java.util.List","java.lang.String")
            .implementation=function(p,h){ console.log("[bypass] ChainCleaner: "+h); return p; }; } catch(e) {}
        console.log("[sync] AndroidCertificateChainCleaner patched");
    });
    safeUse("okhttp3.internal.tls.BasicCertificateChainCleaner", function(C) {
        try { C.clean.overload("java.util.List","java.lang.String")
            .implementation=function(p,h){ return p; }; } catch(e) {}
        console.log("[sync] BasicCertificateChainCleaner patched");
    });
    safeUse("android.security.net.config.RootTrustManager", function(R) {
        try { R.checkServerTrusted.overload(
            "[Ljava.security.cert.X509Certificate;","java.lang.String","java.lang.String"
        ).implementation=function(ch,a,h){ return Java.use("java.util.Arrays").asList(ch); }; } catch(e) {}
        try { R.checkServerTrusted.overload(
            "[Ljava.security.cert.X509Certificate;","java.lang.String"
        ).implementation=function(ch,a){}; } catch(e) {}
        console.log("[sync] RootTrustManager patched");
    });
    safeUse("okhttp3.CertificatePinner", function(CP) {
        try { CP.check.overload("java.lang.String","java.util.List").implementation=function(h,c){}; } catch(e) {}
        try { CP["check$okhttp"].overload("java.lang.String","java.util.List").implementation=function(h,c){}; } catch(e) {}
        console.log("[sync] OkHttp CertificatePinner patched");
    });

    // ── SystemProperties / Build ──────────────────────────────────
    safeUse("android.os.SystemProperties", function(SP) {
        var g1=SP.get.overload("java.lang.String");
        g1.implementation=function(k){
            if(k==="ro.debuggable"||k==="service.adb.root") return "0";
            if(k==="ro.secure") return "1";
            if(k==="ro.build.tags"){var v=g1.call(this,k);return(v&&v.indexOf("test")!==-1)?"release-keys":v;}
            return g1.call(this,k);
        };
        SP.get.overload("java.lang.String","java.lang.String").implementation=function(k,d){
            if(k==="ro.debuggable"||k==="service.adb.root") return "0";
            if(k==="ro.secure") return "1";
            return SP.get.overload("java.lang.String","java.lang.String").call(this,k,d);
        };
        console.log("[sync] SystemProperties patched");
    });
    safeHook(function() {
        var B=Java.use("android.os.Build");
        B.FINGERPRINT.value ="google/walleye/walleye:8.1.0/OPM1.171019.011/4448085:user/release-keys";
        B.MODEL.value       ="Pixel 2"; B.MANUFACTURER.value="Google"; B.BRAND.value="google";
        B.DEVICE.value      ="walleye"; B.PRODUCT.value="walleye"; B.HARDWARE.value="walleye";
        B.TAGS.value        ="release-keys";
        console.log("[sync] Build fields spoofed");
    });

    console.log("[v11] Stage 2 done");
});

// ================================================================
// STAGE 3 — Java.perform (async, includes registerClass)
// ================================================================
console.log("[v11] Stage 3: Async Java hooks");

Java.perform(function() {

    var _AL=Java.use("java.util.ArrayList");
    var _AR=Java.use("java.util.Arrays");
    function newAL()   { return _AL.$new(); }
    function asList(a) { return _AR.asList(a); }

    // ── Package name ──────────────────────────────────────────────
    var PKG="";
    try { if(typeof Script!=="undefined"&&Script.args&&Script.args.length>0&&Script.args[0].indexOf(".")!==-1) PKG=Script.args[0].trim(); } catch(e) {}
    if(PKG==="") { try { PKG=Java.use("android.app.ActivityThread").currentApplication().getApplicationContext().getPackageName(); } catch(e) {} }
    console.log("[v11] Target: "+(PKG||"unknown"));

    // ── AppCompat / Material dialogs — use patchBuilder (same safe logic) ─
    // patchBuilder caches original overloads to prevent recursion.
    safeUse("androidx.appcompat.app.AlertDialog$Builder", function(B) {
        patchBuilder(B, "AppCompatAlertDialog");
    });
    safeUse("com.google.android.material.dialog.MaterialAlertDialogBuilder", function(B) {
        patchBuilder(B, "MaterialAlertDialog");
    });

    // ── PackageManager ────────────────────────────────────────────
    safeHook(function() {
        var PM=Java.use("android.app.ApplicationPackageManager");
        var origGPI     = PM.getPackageInfo.overload("java.lang.String","int");
        var origGPIFlag = null; try { origGPIFlag = PM.getPackageInfo.overload("java.lang.String","android.content.pm.PackageManager$PackageInfoFlags"); } catch(e) {}
        var origGIP     = PM.getInstalledPackages.overload("int");
        origGPI.implementation=function(pname,flags){
            if(ROOT_PKGS.indexOf(pname)>-1){console.log("[bypass] getPackageInfo: "+pname);pname="fake.not.here";}
            return origGPI.call(this,pname,flags);
        };
        if (origGPIFlag) try { origGPIFlag.implementation=function(pname,flags){
            if(ROOT_PKGS.indexOf(pname)>-1){pname="fake.not.here";}
            return origGPIFlag.call(this,pname,flags);
        }; } catch(e) {}
        origGIP.implementation=function(flags){
            var list=origGIP.call(this,flags),filtered=newAL(),it=list.iterator();
            while(it.hasNext()){var pkg=it.next();
                if(ROOT_PKGS.indexOf(pkg.packageName.value)===-1) filtered.add(pkg);
                else console.log("[bypass] getInstalledPackages: "+pkg.packageName.value);
            }
            return filtered;
        };
        console.log("[+] PackageManager patched");
    });

