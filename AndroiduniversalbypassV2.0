    // ================================================================
    // GOOGLE PLAY INTEGRITY API — comprehensive bypass
    //
    // How it works (your senior's hint explained):
    //   1. App calls IntegrityManager.requestIntegrityToken(request)
    //   2. Google returns a signed JWT token
    //   3. App sends token to its backend server
    //   4. Backend decodes and checks three verdicts:
    //        - requestDetails.requestPackageName
    //        - appIntegrity.appRecognitionVerdict  (PLAY_RECOGNIZED / UNRECOGNIZED)
    //        - deviceIntegrity.deviceRecognitionVerdict (MEETS_DEVICE_INTEGRITY etc)
    //        - accountDetails.appLicensingVerdict  (LICENSED / UNLICENSED)
    //   5. Backend tells app whether to proceed
    //
    // Bypass approaches (all implemented below):
    //   A. Hook IntegrityManager so requestIntegrityToken never fires
    //   B. Hook StandardIntegrityManager (newer API)
    //   C. Hook the Task/callback that receives the token — replace with
    //      a fake "all passing" token so the backend call passes
    //   D. Hook SafetyNet (legacy) attest()
    //   E. Hook the backend response parsing if done client-side
    // ================================================================

    // ── A. Classic Play Integrity (IntegrityManager) ──────────────
    safeUse("com.google.android.play.core.integrity.IntegrityManager", function(IM) {
        try {
            IM.requestIntegrityToken.implementation = function(request) {
                console.log("[bypass] IntegrityManager.requestIntegrityToken intercepted");
                // Return a fake Task that immediately delivers a spoofed token
                // The token is a JWT with all verdicts set to passing values.
                // Most apps only check appRecognitionVerdict and deviceIntegrity.
                var fakeToken = _buildFakeIntegrityToken();
                return _buildSuccessTask(fakeToken);
            };
            console.log("[+] PlayIntegrity: IntegrityManager patched");
        } catch(e) { console.log("[!] IntegrityManager: "+e); }
    });

    // ── B. Standard Integrity (newer API, 2023+) ──────────────────
    safeUse("com.google.android.play.core.integrity.StandardIntegrityManager", function(SIM) {
        try {
            SIM.requestIntegrityToken.implementation = function(request) {
                console.log("[bypass] StandardIntegrityManager.requestIntegrityToken intercepted");
                return _buildSuccessTask(_buildFakeIntegrityToken());
            };
        } catch(e) {}
        console.log("[+] PlayIntegrity: StandardIntegrityManager patched");
    });

    // ── C. IntegrityTokenResponse — hook getToken() directly ──────
    // If the token request already fired before our hook, intercept
    // the response object to return our fake token instead.
    safeUse("com.google.android.play.core.integrity.IntegrityTokenResponse", function(ITR) {
        try {
            ITR.token.implementation = function() {
                console.log("[bypass] IntegrityTokenResponse.token() replaced");
                return _buildFakeIntegrityToken();
            };
        } catch(e) {}
        console.log("[+] PlayIntegrity: IntegrityTokenResponse patched");
    });

    // ── D. SafetyNet (legacy, still used by older apps) ───────────
    safeUse("com.google.android.gms.safetynet.SafetyNetClient", function(SNC) {
        try {
            SNC.attest.implementation = function(nonce, apiKey) {
                console.log("[bypass] SafetyNet.attest intercepted");
                return _buildSuccessTask(_buildFakeSafetyNetJwt());
            };
        } catch(e) {}
        console.log("[+] SafetyNet: SafetyNetClient.attest patched");
    });

    // SafetyNet via SafetyNetApi directly
    safeUse("com.google.android.gms.safetynet.SafetyNetApi", function(SNA) {
        try { SNA.attest.implementation = function() { return null; }; } catch(e) {}
        console.log("[+] SafetyNet: SafetyNetApi patched");
    });

    // ── E. AttestationResponse — return passing JWS ───────────────
    safeUse("com.google.android.gms.safetynet.SafetyNetApi$AttestationResponse", function(AR) {
        try {
            AR.getJwsResult.implementation = function() {
