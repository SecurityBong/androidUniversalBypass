    safeHook(function() {
        var Timer=Java.use("java.util.Timer");
        try { Timer.schedule.overload("java.util.TimerTask","long","long").implementation=function(task,delay,period){
            try { var cls=task.getClass().getName();
                if(PKG!==""&&cls.indexOf(PKG)===0) console.log("[poll] Timer.schedule: "+cls+" period="+period);
            } catch(e) {}
            return this.schedule(task,delay,period);
        }; } catch(e) {}
        console.log("[+] Timer monitored");
    });

