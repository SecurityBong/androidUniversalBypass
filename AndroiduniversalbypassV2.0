        // Enumerate ALL classes in app package — hook security-looking ones
        try {
            Java.enumerateLoadedClasses({
                onMatch: function(cls) {
                    if (cls.indexOf(PKG)!==0) return;
                    var c=cls.toLowerCase();
                    if (c.indexOf("guardian")!==-1||c.indexOf("security")!==-1||
                        c.indexOf("detect")!==-1||c.indexOf("tamper")!==-1||
                        c.indexOf("integrity")!==-1||c.indexOf("root")!==-1||
                        c.indexOf("protect")!==-1||c.indexOf("check")!==-1||
                        c.indexOf("islogging")!==-1||c.indexOf("annotation")!==-1) {
                        console.log("[scan] "+cls);
                        safeUse(cls, function(SC) {
                            try { SC.invokeSuspend.implementation=function(r){console.log("[KILL] "+cls+".invokeSuspend");return null;}; } catch(e) {}
                            ["isRooted","isHooked","isEmulator","isTampered","isDebug",
                             "detect","check","verify","run","execute","start","doWork"].forEach(function(m){
                                try { SC[m].implementation=function(){console.log("[KILL] "+cls+"."+m+"()");return false;}; } catch(e) {}
                            });
                        });
                    }
                },
                onComplete: function() { console.log("[+] Package scan done"); }
            });
        } catch(e) {}
    }

    console.log("[v11] ==========================================");
