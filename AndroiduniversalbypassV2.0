    // ================================================================
    // CONTINUOUS DETECTION KILLER
    // Stops the re-trigger loop that causes "login briefly then blocked"
    // ================================================================

    // ================================================================
    // CONTINUOUS SSL CHECK KILLER
    // Some apps re-run SSL pinning checks on a timer/coroutine.
    // The pattern: NetworkCallback or Interceptor re-validates cert
    // every N seconds. We need to prevent the re-validation, not
    // just the initial one.
    // ================================================================

    // OkHttp Interceptor — hook the intercept() method on ALL
    // app-package interceptors. These are called on every request.
    safeHook(function() {
        var Interceptor_cls = Java.use("okhttp3.Interceptor");
        Java.enumerateLoadedClasses({
            onMatch: function(cls) {
                if (PKG === "" || cls.indexOf(PKG) !== 0) return;
                var c = cls.toLowerCase();
                // Hook intercept() on network/security interceptors
                if (c.indexOf("interceptor") !== -1 || c.indexOf("network") !== -1 ||
                    c.indexOf("ssl") !== -1 || c.indexOf("cert") !== -1 ||
                    c.indexOf("pin") !== -1) {
                    safeUse(cls, function(IC) {
                        try {
                            IC.intercept.implementation = function(chain) {
                                console.log("[bypass] interceptor.intercept() passed: "+cls);
                                return chain.proceed(chain.request());
                            };
                        } catch(e) {}
                    });
                }
            },
            onComplete: function() {}
        });
        console.log("[+] OkHttp app interceptors patched");
    });

    // NetworkSecurityConfig — Android's built-in cert pinning system.
    // Apps can define pins in network_security_config.xml.
    // Hook the pin matcher so it never matches a pin failure.
    safeUse("android.security.net.config.PinSet", function(PS) {
        try {
            PS.isExpired.implementation = function() { return false; };
        } catch(e) {}
        console.log("[+] PinSet.isExpired patched");
    });
    safeUse("android.security.net.config.NetworkSecurityConfig", function(NSC) {
        try {
            NSC.isCleartextTrafficPermitted.implementation = function() { return true; };
        } catch(e) {}
        console.log("[+] NetworkSecurityConfig patched");
    });

    // Conscrypt SSLEngine — low-level hook that covers ALL SSL regardless
    // of when the client was built or which library is used.
    // beginHandshake() is called at the start of every TLS connection.
    safeUse("com.android.org.conscrypt.ConscryptEngine", function(CE) {
        try {
            CE.beginHandshake.implementation = function() {
                // Null out the hostname verifier so no pinning check runs
                try { this.setHostname(null); } catch(e) {}
                return this.beginHandshake();
            };
        } catch(e) {}
        console.log("[+] ConscryptEngine.beginHandshake patched");
    });

    // SSLSocket.startHandshake — covers HttpURLConnection and other non-OkHttp clients
    safeUse("com.android.org.conscrypt.OpenSSLSocketImpl", function(SSL) {
        try {
            SSL.startHandshake.implementation = function() {
                try { this.setHostname(null); } catch(e) {}
                return this.startHandshake();
            };
        } catch(e) {}
        console.log("[+] OpenSSLSocketImpl.startHandshake patched");
    });

    // ── Kotlin coroutine invokeSuspend — broadest possible hook ───
    // Logs ALL app coroutines so you can identify the poller.
    // Security-named ones are killed immediately.
    safeHook(function() {
        var BC=Java.use("kotlin.coroutines.jvm.internal.BaseContinuationImpl");
        BC.invokeSuspend.implementation=function(result) {
            try {
                var cls=this.getClass().getName();
                if (PKG!==""&&cls.indexOf(PKG)===0) {
                    var c=cls.toLowerCase();
                    // Kill known security coroutine patterns
                    if (c.indexOf("guardian")!==-1||c.indexOf("islogging")!==-1||
                        c.indexOf("annotation")!==-1||c.indexOf("security")!==-1||
                        c.indexOf("detect")!==-1||c.indexOf("tamper")!==-1||
                        c.indexOf("integrity")!==-1||c.indexOf("protect")!==-1) {
                        console.log("[KILL] coroutine: "+cls);
                        return null;
                    }
                    // Log all others — look for lines when block re-appears
                    console.log("[coroutine] "+cls);
                }
            } catch(e) {}
            return this.invokeSuspend(result);
        };
        console.log("[+] Kotlin invokeSuspend hooked (full logging)");
    });

    // ── Handler.postDelayed — log scheduled tasks from app pkg ────
    safeHook(function() {
        var Handler=Java.use("android.os.Handler");
        Handler.postDelayed.overload("java.lang.Runnable","long").implementation=function(r,delay){
            try {
                var cls=r.getClass().getName();
                if(PKG!==""&&cls.indexOf(PKG)===0) console.log("[poll] postDelayed: "+cls+" delay="+delay);
            } catch(e) {}
            return this.postDelayed(r,delay);
        };
        console.log("[+] Handler.postDelayed monitored");
    });

